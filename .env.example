# Backend de dados: "local" (arquivo JSON em .data/, apenas desenvolvimento) ou "supabase"
DATA_BACKEND=local

# Supabase (obrigatório quando DATA_BACKEND=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Somente no servidor. Nunca expor ao cliente.
SUPABASE_SERVICE_ROLE_KEY=

# IA (Fase 2) — somente no servidor
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
